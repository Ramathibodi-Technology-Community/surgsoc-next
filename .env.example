# --- Core Config ---
# The secret used to sign cookies/tokens. Make it long and zesty.
PAYLOAD_SECRET=your-super-secret-key-here
# The base URL of your site (use your Vercel production URL in production)
# Example: https://surgsoc.mahidol.edu
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database ---
# Your Postgres connection string (Supabase, Neon, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/surgsoc

# --- Google OAuth ---
# From your Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional explicit callback override. If omitted, defaults to
# ${NEXT_PUBLIC_SERVER_URL}/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=SurgSoc <noreply@surgsoc.mahidol.edu>

# --- Seeding (local development only) ---
# Email address seeded as the superadmin account. Required — `pnpm run db:seed`
# fails immediately if this is unset, since this is a public repo and there is
# no safe default address to bake in.
SEED_ADMIN_EMAIL=you@example.com
# Password given to every account created by `pnpm run db:seed`.
# Seeded users normally sign in with Google; set this only if you need to log in
# as a seeded account with email + password. Leave BLANK/unset in any shared or
# deployed environment — unset means each run gets a random, unknowable password.
# NEVER set this in production.
SEED_PASSWORD=
