{
  "name": "surgsoc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck",
    "vercel-build": "pnpm run check && pnpm run build",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "pnpm exec payload generate:importmap",
    "db:up": "docker compose up -d payload-db",
    "db:reset": "tsx --import ./scripts/css-stub.mjs scripts/reset-db.ts",
    "db:seed": "tsx --import ./scripts/css-stub.mjs scripts/seed-db.ts",
    "db:seed:tags": "tsx --import ./scripts/css-stub.mjs scripts/seed-tags.ts",
    "db:seed:groups": "tsx --import ./scripts/css-stub.mjs scripts/seed-groups.ts",
    "db:migrate": "pnpm exec payload migrate",
    "db:refresh": "tsx --import ./scripts/css-stub.mjs scripts/refresh-db.ts",
    "db:fresh": "pnpm run db:migrate && pnpm run db:seed",
    "seed": "pnpm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-resend": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-form-builder": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.574.0",
    "next": "16.3.5",
    "openid-client": "^6.1.7",
    "payload": "^3.90.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.5.4",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "tsx": "^4.21.0",
    "typescript": "5.7.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.6",
      "immutable": "^4.3.9",
      "js-yaml@^4": "^4.3.2",
      "lodash": "^4.18.0",
      "nanoid@^3": "^3.3.18",
      "postcss": "^8.5.28",
      "sharp": "^0.35.4",
      "ws": "^8.21.0",
      "dompurify": "^3.4.15",
      "esbuild@^0.18": "^0.25.0",
      "yaml@^1": "^1.10.3",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "brace-expansion@^2": "^2.1.4",
      "flatted": "^3.4.2",
      "minimatch@^9": "^9.0.7",
      "minimatch@^3": "^3.1.4",
      "brace-expansion@^1": "^1.1.18",
      "ajv@^6": "^6.14.0",
      "@humanfs/node": "^0.16.8",
      "vite": "^7.3.5",
      "esbuild@^0.27": "^0.28.1"
    }
  }
}
